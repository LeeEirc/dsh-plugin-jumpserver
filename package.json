{
  "name": "dsh-plugin-jumpserver",
  "version": "0.1.1",
  "description": "Connect JumpServer assets to DeepSeek Harness: browser authorization, commands, file transfers, and terminal handoff.",
  "homepage": "https://github.com/LeeEirc/dsh-plugin-jumpserver",
  "repository": { "type": "git", "url": "git+https://github.com/LeeEirc/dsh-plugin-jumpserver.git" },
  "bugs": { "url": "https://github.com/LeeEirc/dsh-plugin-jumpserver/issues" },
  "keywords": ["deepseek-harness", "dsh", "jumpserver", "mcp", "ssh"],
  "type": "module",
  "main": "lib/index.js",
  "bin": { "jumpserver-mcp": "lib/cli.js" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES"],
  "license": "MIT",
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "pack": "node scripts/pack.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.32.2", "semver": "^7.8.6", "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
